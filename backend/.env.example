# ─────────────────────────────────────────────
# CCE ScoreSync – Backend Environment Config
# Copy this file to .env and fill in values
# DO NOT commit .env to source control
# ─────────────────────────────────────────────

# Gemini API Key (required for AI extraction)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini Model (default: gemini-1.5-flash)
# Other options: gemini-1.5-pro, gemini-2.0-flash, gemini-2.5-flash-preview
GEMINI_MODEL=gemini-1.5-flash

# File storage paths (relative to backend/)
UPLOAD_DIR=storage/uploads
SESSION_DIR=storage/sessions

# File size limit in MB
MAX_FILE_SIZE_MB=50

# Max files per source per session
MAX_FILES_PER_SOURCE=50

# Score comparison tolerance (0.0 = exact match)
SCORE_TOLERANCE=0.0

# Min AI confidence score to auto-accept (0.0–1.0)
MIN_CONFIDENCE_THRESHOLD=0.7

# CORS allowed origins (comma-separated if using env, or set in config.py)
# ALLOWED_ORIGINS=http://localhost:5173

# Debug mode
DEBUG=false

